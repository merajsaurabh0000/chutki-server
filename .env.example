NODE_ENV=development
PORT=3000

# MongoDB Atlas / local MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/chutki

# Comma-separated production web/admin origins, for example:
# https://ghop-ghop-admin.onrender.com,https://ghop-ghop-api.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth/session secrets. Use 32+ random characters in production.
COOKIE_PASSWORD=replace-with-32-plus-random-characters
ACCESS_TOKEN_SECRET=replace-with-32-plus-random-characters
REFRESH_TOKEN_SECRET=replace-with-32-plus-random-characters
ADMIN_API_KEY=replace-with-32-plus-random-characters

# Customer OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google login
GOOGLE_WEB_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Kaggle import
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
